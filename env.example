# ============================================================
# YouTube Shorts Bot - Environment Variables
# Copy this to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# --- Project ---
PROJECT_NAME=YT_Shorts_Bot
LOG_LEVEL=INFO
OUTPUT_DIR=./output
DATA_DIR=./data
DB_PATH=./data/bot.db

# --- Scheduling ---
SCHEDULE_HOURS=6          # Run every N hours
MAX_VIDEOS_PER_DAY=4

# --- Trend Discovery ---
# Reddit (free - create app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=YTShortsBot/1.0

# Subreddits to monitor (comma-separated)
REDDIT_SUBREDDITS=technology,science,worldnews,funny,todayilearned,explainlikeimfive

# GNews API (free tier: 100 req/day at https://gnews.io)
GNEWS_API_KEY=your_gnews_api_key

# Currents API (free tier: https://currentsapi.services)
CURRENTS_API_KEY=your_currents_api_key

# Google Trends - no key needed, uses pytrends (unofficial)
GTRENDS_GEO=US
GTRENDS_TIMEFRAME=now 1-d

# --- Topic Scoring Weights ---
WEIGHT_SEARCH_VOLUME=0.30
WEIGHT_RECENCY=0.25
WEIGHT_VIRALITY=0.25
WEIGHT_COMPETITION=0.20

# --- Script Generation ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
# Fallback to template if Ollama unavailable
USE_TEMPLATE_FALLBACK=true

# --- Voice Synthesis ---
# Options: piper, kokoro, coqui
TTS_ENGINE=piper
PIPER_MODEL=en_US-amy-medium
PIPER_BINARY=./tools/piper/piper
KOKORO_MODEL=af_heart
VOICE_SPEED=1.0
VOICE_PITCH=1.0

# --- Visual Generation ---
# Options: stable_diffusion, pixabay, pexels, unsplash, mixed
VISUAL_ENGINE=mixed

# Pixabay (free, 200 req/hour - https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key

# Pexels (free, 200 req/hour - https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key

# Unsplash (free 50 req/hour - https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Stable Diffusion (local via AUTOMATIC1111 or CPU-mode)
SD_ENABLED=false
SD_HOST=http://localhost:7860
SD_MODEL=dreamshaper_8

# --- Video Settings ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_BITRATE=4000k
AUDIO_BITRATE=192k
FONT_PATH=./assets/fonts/Montserrat-Bold.ttf
CAPTION_FONT_SIZE=52
CAPTION_COLOR=white
CAPTION_BG_OPACITY=0.6
BACKGROUND_MUSIC_VOL=0.15
VOICE_VOL=1.0

# Transitions: fade, slide, zoom, none
DEFAULT_TRANSITION=fade
TRANSITION_DURATION=0.4

# --- Thumbnail Settings ---
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
THUMBNAIL_FONT_SIZE=72

# --- YouTube API ---
YOUTUBE_CLIENT_SECRETS=./config/client_secrets.json
YOUTUBE_TOKEN_FILE=./config/youtube_token.json
YOUTUBE_CHANNEL_ID=your_channel_id

# Default video settings for upload
YT_CATEGORY_ID=28          # Science & Technology
YT_PRIVACY=public          # public / private / unlisted
YT_MADE_FOR_KIDS=false
YT_DEFAULT_TAGS=shorts,trending,viral,facts

# --- n8n (if using n8n orchestration) ---
N8N_HOST=http://localhost:5678
N8N_API_KEY=your_n8n_api_key

# --- Monitoring ---
DISCORD_WEBHOOK=            # Optional: post alerts to Discord
TELEGRAM_BOT_TOKEN=         # Optional: Telegram notifications
TELEGRAM_CHAT_ID=

# --- Growth / A/B Testing ---
AB_TESTING_ENABLED=true
AB_TITLE_VARIANTS=2
